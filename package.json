{
  "name": "apex-delta",
  "version": "1.0.0",
  "private": true,
  "description": "Vehicle arbitrage and sweet-spot tracker for the South African market",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "scripts": {
    "dev": "wasp start",
    "inngest": "npx inngest-cli@latest dev",
    "compile": "wasp compile",
    "build": "wasp build",
    "start": "wasp start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "~5.1.0",
    "inngest": "^3.54.2",
    "playwright": "^1.49.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp.sh/spec": "file:.wasp/spec/",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "5.19.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "@prisma/client@5.19.1": true,
    "@prisma/engines@5.19.1": true,
    "esbuild@0.28.2": true,
    "msw@2.15.0": true,
    "prisma@5.19.1": true,
    "protobufjs@7.6.6": true
  }
}
